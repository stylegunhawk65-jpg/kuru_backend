# Application Configuration
PROJECT_NAME="Kuru Backend"
ENVIRONMENT="development"
DEBUG=true
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated list of origins)
# For production, specify exact client origins (e.g. "https://app.yourdomain.com")
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# PostgreSQL Database Configuration
# Uses asyncpg driver: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/kuru_db"

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Firebase Authentication Configuration
# Provide path to your serviceAccountKey.json or set project ID
# FIREBASE_CREDENTIALS_PATH="/path/to/serviceAccountKey.json"
# FIREBASE_PROJECT_ID="your-firebase-project-id"

# Encryption Key for External Tokens (Base64-encoded 32-byte key)
ENCRYPTION_KEY="kuru_dev_secret_key_32_bytes_safe_fallback_123="

# GitHub OAuth App Configuration (Optional)
# GITHUB_CLIENT_ID="your_github_client_id"
# GITHUB_CLIENT_SECRET="your_github_client_secret"

# Job & Internship Data Sources (Optional credentials for partner APIs)
# ADZUNA_APP_ID="your_adzuna_app_id"
# ADZUNA_APP_KEY="your_adzuna_app_key"
# UNSTOP_API_KEY="your_unstop_partner_key"
# NAUKRI_API_KEY="your_naukri_partner_key"

# Local LLM & AI Inference Configuration (Phase 6)
# Options: "mock" (fast dev/testing, zero GPU/download required), "local" (RTX 4050 4-bit)
LLM_PROVIDER="mock"
LOCAL_MODEL_ID="Qwen/Qwen2.5-3B-Instruct"
# LOCAL_MODEL_PATH="C:/Users/ADMIN/.cache/kuru_models/Qwen2.5-3B-Instruct"
LOCAL_MODEL_DEVICE="cuda"
LOCAL_MODEL_QUANTIZATION="4bit"
LLM_TIMEOUT_SECONDS=180.0
LLM_MAX_NEW_TOKENS=650
LLM_TEMPERATURE=0.7
